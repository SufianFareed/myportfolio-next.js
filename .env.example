# Resend API key — get one at https://resend.com
RESEND_API_KEY=

# The inbox where contact form messages should be delivered
CONTACT_EMAIL=

# The "from" address Resend sends as — must be a verified domain on your Resend account
# (during development you can use Resend's default: onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL — used for metadata, sitemap.xml, and robots.txt
# Set this to your real domain once you have one (e.g. https://sufianfareed.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
